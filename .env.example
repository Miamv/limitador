# ==============================================================
# Plantilla de variables de entorno - Copiar como .env
# ==============================================================

# Base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/limitador_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Autenticación y Tokens JWT (JWT_SECRET debe tener al menos 32 caracteres)
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_ME_EXPIRATION_MS=604800000

# Ciclo de vida y Graceful Shutdown (IX Desechabilidad - 12 factor app)
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=20s

# MaxMind GeoIP2 / GeoLite2 Databases
GEOIP_DATABASE_CITY_PATH=file:/geolite/GeoLite2-City.mmdb
GEOIP_DATABASE_COUNTRY_PATH=file:/geolite/GeoLite2-Country.mmdb
GEOIP_DATABASE_ASN_PATH=file:/geolite/GeoLite2-ASN.mmdb
GEOIP_DATABASE_CACHE_SIZE=4096
